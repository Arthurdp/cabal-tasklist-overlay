{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cabal Tasklist Overlay",
  "version": "1.1.0",
  "identifier": "com.cabal.tasklistoverlay",
  "build": {
    "beforeDevCommand": "npm run start:web",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cabal Tasklist Overlay",
        "width": 920,
        "height": 1080,
        "x": 80,
        "y": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../build/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
